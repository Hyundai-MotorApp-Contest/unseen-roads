<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@drawable/prism_backdrop">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center"
        android:paddingHorizontal="24dp" android:paddingVertical="20dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/private_title" android:textSize="40sp" android:fontFamily="sans-serif-medium" android:textColor="@color/glass_ink" android:accessibilityHeading="true" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/private_status" android:textSize="22sp" android:textColor="@color/glass_secondary"  />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:orientation="vertical"
        android:background="@drawable/prism_control" android:padding="20dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/private_car_title" android:textSize="26sp" android:fontFamily="sans-serif-medium" android:textColor="@color/glass_ink" android:accessibilityHeading="true" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/private_car_empty" android:textSize="22sp" android:textColor="@color/glass_secondary" android:layout_marginTop="4dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:orientation="vertical"
        android:background="@drawable/prism_control" android:padding="20dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/private_voice_title" android:textSize="26sp" android:fontFamily="sans-serif-medium" android:textColor="@color/glass_ink" android:accessibilityHeading="true" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/private_voice_empty" android:textSize="22sp" android:textColor="@color/glass_secondary" android:layout_marginTop="4dp" />
        </LinearLayout>
        <Button
            android:id="@+id/records_back"
            style="@style/PrismAction"
            android:layout_marginTop="20dp"
            android:text="@string/back_to_home" />
    </LinearLayout>
</ScrollView>
