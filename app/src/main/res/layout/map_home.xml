<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/glass_canvas"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.16"
            android:text="@string/app_name"
            android:textColor="@color/hyundai_navy"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/map_title"
            android:textColor="@color/glass_ink"
            android:textSize="34sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/glass_panel"
            android:clipToOutline="true">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/map_description"
                android:scaleType="fitXY"
                android:src="@drawable/story_map_preview" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="14dp"
                android:background="@drawable/glass_panel"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="@string/map_sample"
                android:textColor="@color/glass_ink"
                android:textSize="15sp" />

            <ImageButton
                android:id="@+id/map_radio"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="16dp"
                android:background="@drawable/glass_secondary_button"
                android:contentDescription="@string/radio_open"
                android:elevation="6dp"
                android:padding="3dp"
                android:scaleType="fitCenter"
                android:src="@drawable/radio_orb"
                android:stateListAnimator="@animator/glass_press" />
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/map_legend"
            android:textColor="@color/glass_ink"
            android:textSize="17sp" />

        <Button
            android:id="@+id/map_story"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/welcome_button"
            android:minHeight="56dp"
            android:paddingHorizontal="22dp"
            android:stateListAnimator="@animator/glass_press"
            android:text="@string/demo_start_story"
            android:textAllCaps="false"
            android:textColor="@color/glass_on_primary" />
    </LinearLayout>
</ScrollView>
