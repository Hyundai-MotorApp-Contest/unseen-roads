<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/prism_backdrop"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="40dp"
        android:paddingTop="24dp"
        android:paddingEnd="40dp"
        android:paddingBottom="24dp">

        <io.github.hyundaimotorappcontest.unseen.GlassPanel
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3"
            android:background="@drawable/prism_control"
            android:padding="32dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.16"
                android:text="@string/app_name"
                android:textColor="@color/glass_secondary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:id="@+id/screen_label"
                android:text="@string/welcome_label"
                android:textColor="@color/glass_secondary"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/welcome_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:fontFamily="sans-serif"
                android:text="@string/welcome_title"
                android:textColor="@color/glass_ink"
                android:textSize="44sp" />

            <TextView
                android:id="@+id/welcome_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:accessibilityLiveRegion="polite"
                android:text="@string/welcome_description"
                android:textColor="@color/glass_secondary"
                android:textSize="24sp" />

            <Button
                android:id="@+id/welcome_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/welcome_button"
                android:elevation="5dp"
                android:minHeight="72dp"
                android:minWidth="184dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="@string/welcome_start"
                android:stateListAnimator="@animator/glass_press"
                android:textAllCaps="false"
                android:textColor="@color/glass_on_primary"
                android:textSize="24sp" />
            <Button
                android:id="@+id/secondary_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/glass_secondary_button"
                android:minHeight="72dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:stateListAnimator="@animator/glass_press"
                android:textAllCaps="false"
                android:textColor="@color/glass_ink"
                android:textSize="24sp"
                android:visibility="gone" />
        </io.github.hyundaimotorappcontest.unseen.GlassPanel>

        <io.github.hyundaimotorappcontest.unseen.GlassPanel
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_weight="2"
            android:background="@drawable/prism_control"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp">

            <io.github.hyundaimotorappcontest.unseen.PrismOrbView
                android:id="@+id/flow_orb"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/orb_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/orb_idle"
                android:textColor="@color/glass_secondary"
                android:textSize="24sp" />

            <Button
                android:id="@+id/tertiary_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/glass_secondary_button"
                android:minHeight="72dp"
                android:paddingHorizontal="20dp"
                android:text="@string/back_to_home"
                android:textSize="24sp"
                android:stateListAnimator="@animator/glass_press"
                android:textAllCaps="false"
                android:textColor="@color/glass_ink"
                android:visibility="gone" />
        </io.github.hyundaimotorappcontest.unseen.GlassPanel>
    </LinearLayout>
</ScrollView>
